# ============================================================
# harness-lab .editorconfig
# 统一编辑器行为：UTF-8 (无 BOM)、LF、2 空格缩进、行尾去空格。
# 背景：本机控制台代码页为 936(GBK)、PS 5.1 重定向默认 UTF-16LE，
#       全项目强制 UTF-8 无 BOM 是规避乱码的第一道防线。
# ============================================================
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
