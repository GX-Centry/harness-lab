# ============================================================
# harness-lab 环境变量示例 —— 复制为 .env 后按需填写（.env 已被忽略，不会入库）
# ============================================================
#
# 接入任意 OpenAI 兼容服务（DeepSeek / OpenAI / 硅基流动 / Moonshot /
# 智谱 / 通义千问 / Ollama / llama.cpp / one-api 网关…）：
#
#   判定规则：下面三者中只要出现 API_KEY 或 BASE_URL → 启用真实模式；
#             三个都缺省 → 离线演示模式（规则 Provider，确定性、无网络）。
#
#   CLI：   启动时读取，静态生效（pnpm dev / pnpm chat）
#   网页：  启动时作为缺省，运行中可在顶栏「服务设置」热切换——
#           无 key 也可先用本地 mock 演示全链路：pnpm mock-llm

# API 密钥（本地服务如 Ollama / llama.cpp 留空即可——不发 Authorization 头）
HARNESS_LLM_API_KEY=

# OpenAI 兼容端点（通常以 /v1 结尾；缺省 DeepSeek）
#   例：https://api.deepseek.com/v1
#       https://api.openai.com/v1
#       http://127.0.0.1:11434/v1        （Ollama）
#       http://127.0.0.1:8099/v1         （本仓库 mock：pnpm mock-llm）
HARNESS_LLM_BASE_URL=

# 模型名（缺省 deepseek-chat）
#   例：deepseek-chat / deepseek-reasoner / gpt-4o-mini / qwen3:8b / mock-chat
HARNESS_LLM_MODEL=

# ------------------------------------------------------------
# 可选：本地脚本端口（一般无需修改）
# ------------------------------------------------------------
# 网页控制台端口（缺省 4173）——pnpm web
# HARNESS_WEB_PORT=4173

# 本地 mock 服务端口（缺省 8099）——pnpm mock-llm
# HARNESS_MOCK_PORT=8099
