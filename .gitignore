# ============================================================
# harness-lab .gitignore
# 说明：本仓库是教学级 Harness 框架，运行时产物（数据库/日志/缓存）
#       一律不入库；所有源码与文档均为 UTF-8 (无 BOM)、LF 换行。
# ============================================================

# --- 依赖 ---
node_modules/

# --- 构建产物 ---
dist/
*.tsbuildinfo

# --- 运行时数据（Session 持久化、记忆库、审计日志等） ---
data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# --- 日志与缓存 ---
*.log
npm-debug.log*
.pnpm-store/
.cache/
.codex-tmp/

# --- 环境变量与密钥（严禁入库） ---
.env
.env.local
.env.*.local

# --- 测试覆盖率 ---
coverage/

# --- 编辑器与系统 ---
.vscode/*
!.vscode/settings.json
.idea/
Thumbs.db
Desktop.ini

# --- 本地临时产物（下划线前缀约定：IDE 截图 / 调试输出等） ---
_web_shot*.png
